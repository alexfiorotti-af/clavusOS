# ClavusOS — copie para .env e preencha (NUNCA commitar o .env)
CLAVUS_DATABASE_URL=postgres://usuario:senha@host:5432/postgres
CLAVUS_DOMINIO_BASE=clavusos.com.br
# Em produção, deixe vazio (a raiz é a vitrine); em dev, o slug do studio local:
CLAVUS_STUDIO_PADRAO=modelo
CLAVUS_MODO=desenvolvimento
# 64 hex — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVUS_CHAVE_MESTRA=
CLAVUS_CHAVE_ROTINA=
# E-mail (Resend); sem a chave, modo dev só registra no log
RESEND_API_KEY=
CLAVUS_EMAIL_REMETENTE=ClavusOS <avisos@clavusos.com.br>
# Cobrança do ClavusOS (conta Asaas da AF)
CLAVUS_ASAAS_AF_CHAVE=
CLAVUS_ASAAS_AF_AMBIENTE=sandbox
CLAVUS_ASAAS_AF_WEBHOOK_TOKEN=
CLAVUS_PRECO_MENSAL=147
# Vitrine
CLAVUS_WHATSAPP=5527996015367
CLAVUS_EMAIL_COMERCIAL=alexfiorotti@gmail.com
CLAVUS_DEMO_SLUG=modelo
CLAVUS_DEMO_SENHA=
